# 🎵 Music4 Mobile Environment Configuration Template
# Sao chép file này thành '.env' và cập nhật giá trị phù hợp với máy của bạn.
# File '.env' đã được đưa vào .gitignore - KHÔNG commit lên Git repository.

# URL REST API Backend Spring Boot
# - Android Emulator dùng: http://10.0.2.2:8080/api
# - iOS Simulator / Web dùng: http://localhost:8080/api
# - Thiết bị thật dùng IP máy chủ nội bộ (ví dụ: http://192.168.1.100:8080/api)
BASE_URL=http://10.0.2.2:8080/api

# URL dịch vụ AI Recommendation (FastAPI)
AI_SERVICE_URL=http://10.0.2.2:8000

# Cấu hình thời gian chờ kết nối mạng (milliseconds)
CONNECT_TIMEOUT=15000
RECEIVE_TIMEOUT=15000
